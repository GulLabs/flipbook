{
  "name": "@gullabs/flipbook-core",
  "version": "3.0.0",
  "description": "Framework-agnostic page-curl engine. Maintained fork of StPageFlip.",
  "license": "MIT",
  "author": "GulLabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/GulLabs/flipbook.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs && node ../../scripts/pack-html-engine.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project core",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "html-engine (raw)",
      "path": "size-check/html-engine.js",
      "limit": "44 kB",
      "gzip": false,
      "brotli": false
    },
    {
      "name": "html-engine (brotli)",
      "path": "size-check/html-engine.js",
      "limit": "11 kB"
    }
  ],
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "size-limit": "^13.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/GulLabs/flipbook/issues"
  },
  "homepage": "https://github.com/GulLabs/flipbook",
  "publishConfig": {
    "access": "public"
  }
}
