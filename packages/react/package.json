{
  "name": "@gullabs/react-flipbook",
  "version": "3.0.0",
  "description": "React 18/19 binding for @gullabs/flipbook-core. Maintained fork of react-pageflip.",
  "license": "MIT",
  "author": "Atif Gul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/flipbook.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/gul-labs/flipbook/issues",
  "homepage": "https://github.com/gul-labs/flipbook/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/banner-use-client.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --project react"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@gullabs/flipbook-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "react",
    "page",
    "flip",
    "book",
    "flipbook"
  ]
}
