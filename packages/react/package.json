{
  "name": "@gullabs/react-flipbook",
  "version": "3.0.0",
  "description": "React 18/19 binding for @gullabs/flipbook-core. Maintained fork of react-pageflip.",
  "license": "MIT",
  "author": "GulLabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/GulLabs/flipbook.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/GulLabs/flipbook/issues"
  },
  "homepage": "https://github.com/GulLabs/flipbook",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/banner-use-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project react"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@gullabs/flipbook-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "react",
    "page",
    "flip",
    "book",
    "flipbook"
  ]
}
