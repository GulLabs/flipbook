{
  "name": "flipbook",
  "private": true,
  "description": "Realistic page-flip libraries for the web — vanilla TypeScript core and React wrapper.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GulLabs/flipbook.git"
  },
  "homepage": "https://github.com/GulLabs/flipbook",
  "bugs": {
    "url": "https://github.com/GulLabs/flipbook/issues"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "quality": "node ./scripts/quality.mjs",
    "quality:ci": "node ./scripts/quality.mjs",
    "size": "pnpm --filter @gullabs/flipbook-core size"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "1.59.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
