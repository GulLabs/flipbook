{
  "name": "flipbook",
  "private": true,
  "description": "Realistic page-flip libraries for the web — vanilla TypeScript core and React wrapper.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GulLabs/flipbook.git"
  },
  "homepage": "https://github.com/GulLabs/flipbook",
  "bugs": {
    "url": "https://github.com/GulLabs/flipbook/issues"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "quality": "pnpm preflight && pnpm typecheck && pnpm lint && pnpm test",
    "quality:ci": "pnpm preflight && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm size && node ./scripts/check-isolated-types.mjs",
    "size": "pnpm --filter @gullabs/flipbook-core size",
    "prepare": "husky",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:all": "pnpm typecheck",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preflight": "node ./scripts/quality.mjs",
    "quality:full": "pnpm quality:ci && pnpm format:check && pnpm audit --audit-level=high",
    "audit": "pnpm audit --audit-level=high",
    "build:examples": "pnpm -r --filter './examples/*' --if-present build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "terser": "^5.51.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
